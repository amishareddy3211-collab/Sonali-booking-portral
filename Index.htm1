<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sonali Services</title>
<style>
body{font-family:sans-serif;background:#f5f5f5;padding:15px}
.box{background:white;padding:20px;border-radius:12px;max-width:500px;margin:auto}
input,select,textarea{width:100%;padding:12px;margin:8px 0;border:1px solid #ccc;border-radius:8px;box-sizing:border-box}
.qr-box{text-align:center;background:#e8ffe8;padding:15px;border-radius:10px}
.btn{background:#0088cc;color:white;border:none;padding:14px;width:100%;border-radius:8px;font-weight:bold;cursor:pointer}
</style>
</head>
<body>
<div class="box">
<h1 id="businessName">Sonali Services</h1>
<input type="text" id="custName" placeholder="Customer Name">
<input type="tel" id="custMobile" placeholder="Mobile Number">
<select id="priceSelect"></select>
<div class="qr-box">
<b id="upiText"></b><br>
<img id="qrImg" width="200">
</div>
<input type="file" id="screenshot" accept="image/*">
<button class="btn" onclick="submitOrder()">Payment Bhejo - Telegram</button>
<p id="status"></p>
</div>
<script>
const DATA={name:"Sonali Services",upi:"sonali@oksbi",prices:"500 - Basic Plan\n1000 - Standard Plan\n2000 - Premium Plan",token:"8791716212:AAG8Rwj1OOg_rmWljehqWfFM5S0SEB5ogMI",chatId:"8997697799"};
let saved=JSON.parse(localStorage.getItem('sonaliData'))||DATA;
document.getElementById('businessName').innerText=saved.name;
document.getElementById('upiText').innerText=saved.upi;
document.getElementById('qrImg').src=`https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=upi://pay?pa=${saved.upi}&pn=${saved.name}`;
let sel=document.getElementById('priceSelect'); sel.innerHTML=""; saved.prices.split('\n').forEach(p=>{if(p.trim()){let o=document.createElement('option');o.value=p;o.innerText=p;sel.appendChild(o)}});
async function submitOrder(){
 let name=document.getElementById('custName').value; let mobile=document.getElementById('custMobile').value;
 let price=document.getElementById('priceSelect').value; let file=document.getElementById('screenshot').files[0];
 if(!name||!mobile){alert('Naam Mobile bharo');return}
 let text=`NEW ORDER%0AName: ${name}%0AMobile: ${mobile}%0APlan: ${price}`;
 document.getElementById('status').innerText="Bhej rahe hain...";
 await fetch(`https://api.telegram.org/bot${saved.token}/sendMessage?chat_id=${saved.chatId}&text=${text}`);
 if(file){let fd=new FormData();fd.append('chat_id',saved.chatId);fd.append('photo',file);await fetch(`https://api.telegram.org/bot${saved.token}/sendPhoto`,{method:'POST',body:fd});}
 document.getElementById('status').innerText="Telegram par chala gaya!";
}
</script>
</body>
</html>
